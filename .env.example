# HIVE_USERNAME=
# HIVE_PASSWORD=
# ENABLE_SCHEDULER=true
# RETENTION_DAYS=7
# MAX_SNAPSHOT_AGE_HOURS=24
# METADATA_TIMEZONE=Asia/Shanghai
